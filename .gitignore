# ===== Dependencies =====
node_modules/
.npm/
.yarn/
.pnp.*
jspm_packages/

# NOTE: lock files are committed on purpose (reproducible installs).
# Keep package-lock.json / yarn.lock / pnpm-lock.yaml in version control.

# ===== Build output (TypeScript) =====
dist/
build/
out/
*.tsbuildinfo

# ===== Environment variables / secrets =====
.env
.env.*
*.local
# ...but keep example/template files tracked
!.env.example
!env.example
!env.docker.template
# Keys & certificates
*.pem
*.key
*.crt
*.p12
*.pfx
serviceAccount*.json

# ===== Logs =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===== Runtime / process managers =====
pids/
*.pid
*.seed
*.pid.lock
.pm2/

# ===== Test / coverage =====
coverage/
.nyc_output/
.jest/
*.lcov

# ===== Uploads (multer / user content) =====
uploads/
public/uploads/

# ===== Archives & deployment artifacts =====
*.tar
*.tar.gz
*.tgz
*.zip
*.rar
*.gz

# ===== Caches =====
.cache/
.eslintcache
.parcel-cache/

# ===== Temporary files =====
tmp/
temp/
*.tmp

# ===== OS files =====
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
# Windows null-device artifact
nul

# ===== IDE / editors =====
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
